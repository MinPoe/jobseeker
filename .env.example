# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/jobseekerdb
DATABASE_USERNAME=CHANGE_USERNAME
DATABASE_PASSWORD=CHANGE_PASSWORD

# JWT Configuration
JWT_SECRET=minimum_256bits
JWT_EXPIRATION_MS=86400000

# Optional Configuration (with defaults)
SERVER_PORT=8080
HIBERNATE_DDL_AUTO=update
SHOW_SQL=true
FORMAT_SQL=true

# Logging Levels (optional)
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_HIBERNATE=TRACE

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true